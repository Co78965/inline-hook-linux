CXX := g++
CXXFLAGS := -std=c++17 -O2 -Wall -Wextra -MMD -MP
LDFLAGS :=
LIBS := -ldl -lZydis

SRCS := main.cpp HookPatch.cpp
OBJS := $(patsubst %.cpp,build/%.o,$(SRCS))
DEPS := $(patsubst %.o,%.d,$(OBJS))

BIN_DIR := ../bin
TARGET := $(BIN_DIR)/hook_test

.PHONY: all clean run dirs

all: dirs $(TARGET)

dirs:
	@mkdir -p $(BIN_DIR)
	@mkdir -p build

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) $(LIBS)

build/%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

run: all
	$(TARGET)

clean:
	-rm -rf build
	-rm -f $(TARGET)

-include $(DEPS)
